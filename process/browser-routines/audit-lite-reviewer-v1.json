{
  "schemaVersion": "curveyield-browser-routine-v1",
  "id": "audit-lite-reviewer-v1",
  "description": "Open the campaign's persisted ChatGPT Project share link, create a reviewer chat inside that same Project, then rename the durable conversation after the wake message.",
  "stages": {
    "before_message": [
      {
        "operation": "chatgpt.ensure_chat_mode"
      },
      {
        "operation": "chatgpt.open_project_by_share_link",
        "args": {
          "projectUrl": "{{projectUrl}}"
        }
      },
      {
        "operation": "chatgpt.start_chat_in_open_project"
      }
    ],
    "after_message": [
      {
        "operation": "chatgpt.rename_current_chat",
        "args": {
          "chatName": "{{chatName}}"
        }
      }
    ]
  }
}
