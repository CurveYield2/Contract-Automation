{
  "schemaVersion": "curveyield-browser-routine-v1",
  "id": "audit-lite-reviewer-project-create-v1",
  "description": "Phase 1 only: create the campaign Project, capture its Share-link URL, start the reviewer chat inside it, then rename the chat.",
  "stages": {
    "before_message": [
      {"operation":"chatgpt.ensure_chat_mode"},
      {"operation":"chatgpt.create_project","args":{"projectName":"{{projectName}}"}},
      {"operation":"chatgpt.capture_project_share_link","args":{"projectName":"{{projectName}}"}},
      {"operation":"chatgpt.start_current_project_chat","args":{"projectName":"{{projectName}}"}}
    ],
    "after_message": [
      {"operation":"chatgpt.rename_current_chat","args":{"chatName":"{{chatName}}"}}
    ]
  }
}
