{
  "schemaVersion": "curveyield-browser-routine-v1",
  "id": "development-agent-project-open-v1",
  "description": "Managed development task successor/replacement: open the persisted task Project URL, create a fresh worker chat inside it, then rename the chat. Never creates a second Project.",
  "stages": {
    "before_message": [
      {"operation":"chatgpt.ensure_chat_mode"},
      {"operation":"chatgpt.open_project_url","args":{"projectName":"{{projectName}}","projectUrl":"{{projectUrl}}"}},
      {"operation":"chatgpt.start_current_project_chat","args":{"projectName":"{{projectName}}","projectUrl":"{{projectUrl}}"}}
    ],
    "after_message": [
      {"operation":"chatgpt.rename_current_chat","args":{"chatName":"{{chatName}}"}}
    ]
  }
}
