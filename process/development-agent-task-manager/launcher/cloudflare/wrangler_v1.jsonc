{
  "name": "curveyield-upgrade-agent-launcher-v1",
  "main": "src/worker_v1.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "GITHUB_OWNER": "CurveYield2",
    "CONTROL_REPO": "Contract-Automation",
    "ALLOWED_TARGET_REPOSITORIES": "CurveYield2/Contract-Automation,CurveYield2/Audit-Controller",
    "DEFAULT_AUTHORITY_PATH": "process/development-agent-task-manager/UPGRADE_AGENT_EXECUTION_AUTHORITY_v1.md",
    "CF_ACCESS_REQUIRED": "true"
  }
}
