{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit-v7-phase-contract-v1",
  "title": "Audit V7 Phase Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "authorization",
    "inputs",
    "steps",
    "requiredOutputs",
    "globalControlCheckpoints",
    "sealingCriteria",
    "recoveryRoutes",
    "allowedNextStates",
    "domainApplicability",
    "universalRuleIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "audit-v7-phase-contract-v1"
    },
    "phase": {
      "type": "object",
      "required": [
        "sequence",
        "id",
        "title",
        "reviewerLineage"
      ]
    },
    "authorization": {
      "type": "object"
    },
    "inputs": {
      "type": "object",
      "required": [
        "required",
        "conditional"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1
    },
    "requiredOutputs": {
      "type": "array",
      "minItems": 3
    },
    "globalControlCheckpoints": {
      "type": "object",
      "required": [
        "securityTraceabilityGraph",
        "carriedForwardObligationLedger",
        "evidenceInvalidationMatrix"
      ]
    },
    "sealingCriteria": {
      "type": "array",
      "minItems": 1
    },
    "recoveryRoutes": {
      "type": "array",
      "minItems": 1
    },
    "allowedNextStates": {
      "type": "array",
      "minItems": 1
    },
    "domainApplicability": {
      "type": "object"
    },
    "subgates": {
      "type": "array"
    },
    "universalRuleIds": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^U-[A-Z]+-[0-9]{3}$"
      }
    },
    "subphases": {
      "type": "array"
    }
  }
}
