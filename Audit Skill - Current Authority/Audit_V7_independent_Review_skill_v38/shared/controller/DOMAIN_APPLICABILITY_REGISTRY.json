  "integrityRules": [
    "Exactly one current decision record is required for every domainId in the matrix.",
    "TRIGGERED and UNCERTAIN_INCLUDE must generate/retain the required specialist obligations for applicable future phases.",
    "NOT_TRIGGERED requires recorded negative evidence sufficient to exclude the matrix positive triggers.",
    "New evidence can only strengthen coverage: if uncertainty arises, promote to UNCERTAIN_INCLUDE until resolved.",
    "Phase 4 may not skip a specialist module/ledger without a current NOT_TRIGGERED decision for that domain.",
    "Phase 6/7 must consume current decisions when mapping domain-specific properties/hypotheses to executable fuzz/simulation evidence.",
    "All registry revisions and decision changes are digest-bound in the Phase Report and Security Traceability Graph."
  ],
  "checkpointIntegrity": {
    "digestAlgorithm": "sha256",
    "phaseReportMustReferenceDigest": true
  }
