{
  "schemaVersion": "audit-v7-phase-contract-v1",
  "phase": {
    "sequence": 5,
    "id": "economic-mathematical-review",
    "title": "Economic, Accounting, Mathematical, and Procedural-Independent Review",
    "reviewerLineage": "reviewer-2",
    "phaseCard": "phases/phase-5/START_HERE.md"
  },
  "authorization": {
    "controllerBoundCurrentPhaseRequired": true,
    "exactSourceFenceRequired": true,
    "incomingSuccessorReceipt": null,
    "outgoingSuccessorBoundaryProfile": "P5_TO_P6",
    "automaticAdvanceAfterSeal": true,
    "humanApprovalRequired": false
  },
  "inputs": {
    "required": [
      "Exact controller-bound campaign generation",
      "Exact source identity/fence",
      "Current phase/revision and authorized reviewer lineage",
      "Sealed Phase 4 report and automatic advancement authorization",
      "Current SECURITY_TRACEABILITY_GRAPH checkpoint",
      "Current CARRIED_FORWARD_OBLIGATION_LEDGER checkpoint",
      "Current DOMAIN_APPLICABILITY_REGISTRY checkpoint",
      "Current EVIDENCE_INVALIDATION_MATRIX authority",
      "Latest controller-accepted Source Intelligence Bundle Index revision/commit/digest and component accepted identities bound to the exact current source/build identity"
    ],
    "conditional": [
      "Triggered domain ledgers/resources explicitly referenced by active steps",
      "Live deployment/release/fork/remediation artifacts only when the phase card trigger applies"
    ]
  },
  "steps": [
    {
      "step": 1,
      "action": "Enter the isolated economic/accounting lens",
      "instruction": "Bind exact source/revision and preserve lens isolation.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "../../shared/lenses/SOLO_LENS_ISOLATION_PROTOCOL.md",
        "../../shared/lenses/economic-accounting-lens.md"
      ]
    },
    {
      "step": 2,
      "action": "Review economic correctness",
      "instruction": "Model value flows, incentives, extraction paths, accounting conservation and adversarial economic states.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "../../shared/domain-modules/economic-correctness.md"
      ]
    },
    {
      "step": 3,
      "action": "Verify contract mathematics",
      "instruction": "Check units, bounds, rates, ratios, precision, rounding and edge behavior.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "../../shared/domain-modules/mathematical-verification.md"
      ]
    },
    {
      "step": 4,
      "action": "Review applicable vault/strategy economics",
      "instruction": "Open only when triggered.",
      "requirement": "CONDITIONAL",
      "condition": "CONDITIONAL_AS_DESCRIBED_IN_STEP",
      "resources": [
        "../../shared/domain-modules/domain-vaults-strategies.md",
        "../../shared/domain-ledgers/VAULT_STRATEGY_LEDGER.md"
      ]
    },
    {
      "step": 5,
      "action": "Review applicable oracle economics",
      "instruction": "Open only when triggered.",
      "requirement": "CONDITIONAL",
      "condition": "CONDITIONAL_AS_DESCRIBED_IN_STEP",
      "resources": [
        "../../shared/domain-modules/domain-oracles.md",
        "../../shared/domain-ledgers/ORACLE_ASSURANCE_LEDGER.md"
      ]
    },
    {
      "step": 6,
      "action": "Review applicable lending/liquidation economics",
      "instruction": "Open only when triggered.",
      "requirement": "CONDITIONAL",
      "condition": "CONDITIONAL_AS_DESCRIBED_IN_STEP",
      "resources": [
        "../../shared/domain-modules/domain-lending-liquidation.md",
        "../../shared/domain-ledgers/LENDING_LIQUIDATION_LEDGER.md"
      ]
    },
    {
      "step": 7,
      "action": "Review applicable AMM/hook economics",
      "instruction": "Open only when triggered.",
      "requirement": "CONDITIONAL",
      "condition": "CONDITIONAL_AS_DESCRIBED_IN_STEP",
      "resources": [
        "../../shared/domain-modules/domain-amm-hooks.md",
        "../../shared/domain-ledgers/AMM_HOOK_LEDGER.md"
      ]
    },
    {
      "step": 8,
      "action": "Review applicable staking/reward economics",
      "instruction": "Open only when triggered.",
      "requirement": "CONDITIONAL",
      "condition": "CONDITIONAL_AS_DESCRIBED_IN_STEP",
      "resources": [
        "../../shared/domain-modules/domain-staking-rewards.md",
        "../../shared/domain-ledgers/STAKING_REWARD_LEDGER.md"
      ]
    },
    {
      "step": 9,
      "action": "Perform the source-first procedural retrace",
      "instruction": "Before reconciliation, use the restricted context packet and a procedural-independent source-first retrace; do not describe it as actor independence.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "../../shared/lenses/procedural-independent-review-lens.md",
        "../../shared/lenses/SOLO_LENS_ISOLATION_PROTOCOL.md"
      ]
    },
    {
      "step": 10,
      "action": "Reconcile retrace against Phases 2\u20134",
      "instruction": "Classify prior conclusions CONFIRMED / CONTRADICTED / NEW / UNRESOLVED and identify handoff-critical state.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "resources/PHASE5_RETRACE_RECONCILIATION_MATRIX.md",
        "../../shared/policy/SEVERITY_CALIBRATION.md"
      ]
    },
    {
      "step": 11,
      "action": "Reconcile campaign-global security state",
      "instruction": "Update the canonical Security Traceability Graph for this phase, enumerate and reconcile every obligation due now, add stable OBL-* records for new later-phase work, and freeze current graph/ledger digests for the Phase Report. An OPEN/IN_PROGRESS obligation due in this phase blocks sealing. Classify every material observed change under the Evidence Invalidation Matrix before reusing affected evidence.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "../../shared/controller/SECURITY_TRACEABILITY_GRAPH.json",
        "../../shared/controller/CARRIED_FORWARD_OBLIGATION_LEDGER.json",
        "../../shared/controller/EVIDENCE_INVALIDATION_MATRIX.json"
      ]
    },
    {
      "step": 12,
      "action": "File the Phase 5 report and stop for response",
      "instruction": "Seal Phase 5, reference the reconciliation digest, submit the report, enter `AUTO_ADVANCE_READY` and do not create the successor handoff yet.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "../../shared/reporting/PHASE_REPORT.md",
        "../../shared/controller/AUTOMATIC_PHASE_ADVANCEMENT_PROTOCOL.md"
      ]
    },
    {
      "step": 13,
      "action": "File the Phase 5 report and trigger automatic successor handoff",
      "instruction": "Seal Phase 5, reference the reconciliation/global-state digests, file the Phase Report, enter AUTO_ADVANCE_READY, and immediately build the P5_TO_P6 successor package. No human approval is required.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "../../shared/reporting/PHASE_REPORT.md",
        "../../shared/controller/AUTOMATIC_PHASE_ADVANCEMENT_PROTOCOL.md"
      ]
    },
    {
      "step": 14,
      "action": "Create the P5_TO_P6A successor package automatically",
      "instruction": "Immediately after Phase-5 seal/report, create campaign-local handoffs/P5_TO_P6/SUCCESSOR_HANDOFF.json, START_HERE_SUCCESSOR.md and WAKE_UP_MESSAGE.md. Route the fresh successor to Phase 6A reviewer-3A. Enter WAITING_FOR_SUCCESSOR_AGENT; do not execute Phase 6A.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "../../shared/controller/SOLO_WORKFLOW_STATE_MACHINE.json"
      ]
    }
  ],
  "requiredOutputs": [
    {
      "artifact": "phases/phase-5/resources/PHASE5_RETRACE_RECONCILIATION_MATRIX.md",
      "role": "PHASE_SPECIFIC_STRUCTURED_FILING",
      "required": true
    },
    {
      "artifact": "shared/controller/SECURITY_TRACEABILITY_GRAPH.json",
      "role": "CAMPAIGN_GLOBAL_CHECKPOINT_TEMPLATE; campaign-local graph digest required",
      "required": true
    },
    {
      "artifact": "shared/controller/CARRIED_FORWARD_OBLIGATION_LEDGER.json",
      "role": "CAMPAIGN_GLOBAL_CHECKPOINT_TEMPLATE; campaign-local ledger digest required",
      "required": true
    },
    {
      "artifact": "shared/controller/DOMAIN_APPLICABILITY_REGISTRY.json",
      "role": "CAMPAIGN_GLOBAL_DOMAIN_APPLICABILITY_CHECKPOINT_TEMPLATE; campaign-local digest required",
      "required": true
    },
    {
      "artifact": "shared/reporting/PHASE_REPORT.md",
      "role": "PHASE_REPORT_TEMPLATE",
      "required": true
    },
    {
      "artifact": "handoffs/P5_TO_P6/SUCCESSOR_HANDOFF.json",
      "role": "CAMPAIGN_LOCAL_SUCCESSOR_HANDOFF",
      "required": true
    },
    {
      "artifact": "handoffs/P5_TO_P6/START_HERE_SUCCESSOR.md",
      "role": "CAMPAIGN_LOCAL_SUCCESSOR_BOOTSTRAP",
      "required": true
    },
    {
      "artifact": "handoffs/P5_TO_P6/WAKE_UP_MESSAGE.md",
      "role": "CAMPAIGN_LOCAL_HUMAN_COPYABLE_SUCCESSOR_WAKE_UP_MESSAGE",
      "required": true
    }
  ],
  "globalControlCheckpoints": {
    "securityTraceabilityGraph": {
      "template": "shared/controller/SECURITY_TRACEABILITY_GRAPH.json",
      "requiredBeforeEvidenceSealed": true,
      "phaseRequirement": [
        "Record economic/retrace confirmations, contradictions, new items and downstream execution relationships without rewriting prior nodes."
      ],
      "phaseReportDigestReferenceRequired": true
    },
    "carriedForwardObligationLedger": {
      "template": "shared/controller/CARRIED_FORWARD_OBLIGATION_LEDGER.json",
      "requiredBeforeEvidenceSealed": true,
      "phaseStartDueObligationEnumerationRequired": true,
      "phaseEndDueObligationReconciliationRequired": true,
      "openOrInProgressDueObligationBlocksSeal": true,
      "phaseReportDigestReferenceRequired": true
    },
    "evidenceInvalidationMatrix": {
      "authority": "shared/controller/EVIDENCE_INVALIDATION_MATRIX.json",
      "requiredBeforeEvidenceSealed": true,
      "materialChangeClassificationRequired": true,
      "noChangeDisposition": "NO_MATERIAL_CHANGE_EVENT",
      "invalidatesOrRebindCreatesTraceabilityInvNode": true,
      "unresolvedRetestCreatesObligation": true
    },
    "sourceIntelligence": {
      "template": "shared/source-intelligence/SOURCE_INTELLIGENCE_TEMPLATE.json",
      "protocol": "shared/source-intelligence/SOURCE_INTELLIGENCE_REUSE_PROTOCOL.md",
      "bundleSchema": "shared/source-intelligence/SOURCE_INTELLIGENCE_BUNDLE_SCHEMA.json",
      "bundleTemplate": "shared/source-intelligence/SOURCE_INTELLIGENCE_BUNDLE_TEMPLATE.json",
      "runtimeOverlaySchema": "shared/source-intelligence/RUNTIME_DEPLOYMENT_OVERLAY_SCHEMA.json",
      "readinessOverlaySchema": "shared/source-intelligence/ASSURANCE_READINESS_OVERLAY_SCHEMA.json",
      "requiredBeforeEvidenceSealed": true,
      "bundleIndexRequiredBeforeReuse": true,
      "acceptedRevisionAndDigestRequired": true,
      "mutablePathsNavigationalOnly": true,
      "mode": "REUSE_LATEST_ACCEPTED_MATCHING_SOURCE_BUILD",
      "sourceBuildDigestMatchRequiredBeforeReuse": true,
      "recreateExistingStructuralInventoriesForbidden": true,
      "rawSourceSemanticReviewStillRequiredWhenPhaseMethodNeedsIt": true,
      "phaseReportRelevantSectionsReviewedRequired": true
    }
  },
  "sealingCriteria": [
    "All mandatory phase-card steps completed or have a permitted typed terminal limitation/failure disposition.",
    "Phase-specific structured filing is complete, exact-source-bound, durable, and digest-referenced.",
    "Source Intelligence Bundle checkpoint records the accepted index revision/commit/digest plus materially used component accepted identities, matching source/build identity, reuse/regeneration status, relevant sections reviewed, and any discrepancy/invalidation/limitation; mutable-path authority and redundant structural rediscovery are forbidden.",
    "Security Traceability Graph is updated for this phase and its current campaign-local digest/reference is recorded.",
    "All obligations due in this phase are reconciled in the canonical obligation ledger; no due OPEN/IN_PROGRESS obligation remains.",
    "Every new later-phase obligation has a stable OBL-* ID and objective completion condition.",
    "Phase Report references phase-specific artifact, traceability graph checkpoint, obligation ledger checkpoint, evidence, limitations, and invalidation triggers.",
    "Required process failures have exhausted repair/retry/recovery or are repaired and verified; silent omission is forbidden.",
    "Every material observed change event is classified under EVIDENCE_INVALIDATION_MATRIX; INVALIDATES/REQUIRES_REBIND work is replaced, reconciled, or carried as a typed OBL-* before sealing.",
    "At this fresh-reviewer boundary, the exact filed WAKE_UP_MESSAGE.md is complete, immutable-handoff-URL-bound, contains no unresolved placeholders, and is delivered to the human verbatim in a standalone fenced text copy block after the end-of-phase report."
  ],
  "recoveryRoutes": [
    {
      "condition": "GitHub connector unavailable",
      "resource": "SKILL.md#something-broke--recovery-router"
    },
    {
      "condition": "Controller/campaign/evidence/reporting failure",
      "resource": "shared/lenses/operations-recovery-lens.md"
    },
    {
      "condition": "Technical execution/tool/RPC failure",
      "resource": "shared/execution/EXECUTION_PREFLIGHT_AND_REPAIR_PROTOCOL.md"
    },
    {
      "condition": "Source/release identity change",
      "resource": "shared/policy/PROCESS_INTEGRITY_LEDGER.md"
    }
  ],
  "allowedNextStates": [
    "EVIDENCE_SEALED",
    "PHASE_REPORT_SUBMITTED",
    "AUTO_ADVANCE_READY",
    "WAITING_FOR_SUCCESSOR_AGENT"
  ],
  "domainApplicability": {
    "matrix": "shared/controller/DOMAIN_APPLICABILITY_MATRIX.json",
    "campaignRegistryTemplate": "shared/controller/DOMAIN_APPLICABILITY_REGISTRY.json",
    "mode": "CONSUME_AND_REEVALUATE_IF_NEW_EVIDENCE",
    "uncertainPolicy": "UNCERTAIN_INCLUDE_IS_TREATED_AS_TRIGGERED",
    "phaseReportDigestReferenceRequired": true
  },
  "universalRuleIds": [
    "U-EXEC-001",
    "U-GITHUB-001",
    "U-STATE-001",
    "U-EVIDENCE-001",
    "U-REPAIR-001",
    "U-HUMAN-001",
    "U-DISCLOSURE-001",
    "U-SOURCEINTEL-001",
    "U-UPDATES-001",
    "U-HUMANCOMMS-001"
  ]
}
