  "globalControlCheckpoints": {
    "securityTraceabilityGraph": {
      "template": "shared/controller/SECURITY_TRACEABILITY_GRAPH.json",
      "requiredBeforeEvidenceSealed": true,
      "phaseRequirement": [
        "Add FUZZ-* campaign nodes; map each material fuzzable PROP-*/HYP-* to executed campaign or explicit terminal disposition."
      ],
      "phaseReportDigestReferenceRequired": true
    },
    "carriedForwardObligationLedger": {
      "template": "shared/controller/CARRIED_FORWARD_OBLIGATION_LEDGER.json",
      "requiredBeforeEvidenceSealed": true,
      "phaseStartDueObligationEnumerationRequired": true,
      "phaseEndDueObligationReconciliationRequired": true,
      "openOrInProgressDueObligationBlocksSeal": true,
      "phaseReportDigestReferenceRequired": true
    },
    "evidenceInvalidationMatrix": {
      "authority": "shared/controller/EVIDENCE_INVALIDATION_MATRIX.json",
      "requiredBeforeEvidenceSealed": true,
      "materialChangeClassificationRequired": true,
      "noChangeDisposition": "NO_MATERIAL_CHANGE_EVENT",
      "invalidatesOrRebindCreatesTraceabilityInvNode": true,
      "unresolvedRetestCreatesObligation": true
    },
    "sourceIntelligence": {
      "template": "shared/source-intelligence/SOURCE_INTELLIGENCE_TEMPLATE.json",
      "protocol": "shared/source-intelligence/SOURCE_INTELLIGENCE_REUSE_PROTOCOL.md",
      "bundleSchema": "shared/source-intelligence/SOURCE_INTELLIGENCE_BUNDLE_SCHEMA.json",
      "bundleTemplate": "shared/source-intelligence/SOURCE_INTELLIGENCE_BUNDLE_TEMPLATE.json",
      "runtimeOverlaySchema": "shared/source-intelligence/RUNTIME_DEPLOYMENT_OVERLAY_SCHEMA.json",
      "readinessOverlaySchema": "shared/source-intelligence/ASSURANCE_READINESS_OVERLAY_SCHEMA.json",
      "requiredBeforeEvidenceSealed": true,
      "bundleIndexRequiredBeforeReuse": true,
      "acceptedRevisionAndDigestRequired": true,
      "mutablePathsNavigationalOnly": true,
      "mode": "REUSE_LATEST_ACCEPTED_MATCHING_SOURCE_BUILD",
      "sourceBuildDigestMatchRequiredBeforeReuse": true,
      "recreateExistingStructuralInventoriesForbidden": true,
      "rawSourceSemanticReviewStillRequiredWhenPhaseMethodNeedsIt": true,
      "phaseReportRelevantSectionsReviewedRequired": true,
      "readinessOverlayRequired": true,
      "readinessAdequacyOwnerSubphase": "phase-6A",
      "phase6BAnd6CMustUseAcceptedReadinessRevision": true
    }
  },
  "sealingCriteria": [
    "All original P6.0\u2013P6.8 subgates are terminal in order and all Process 1\u201311 dispositions required by the preserved v28 methodology remain satisfied.",
    "Phase 6A, 6B and 6C were executed by fresh reviewer-3A, reviewer-3B and reviewer-3C lineages respectively, or an in-flight v28 campaign followed the explicit no-repeat migration rule.",
    "The Accounting Assurance Model is complete for accounting-bearing targets or has evidence-backed typed NOT_APPLICABLE/LIMITED disposition.",
    "Randomized accounting attack/chaos work is executed or explicitly not applicable with evidence; absence of future automation is not an applicability waiver.",
    "Known/historical attack patterns are dispositioned through the qualified KB when available or the built-in transitional fallback checklist when unavailable.",
    "Critical harness/property sensitivity is demonstrated with mutation/fault evidence where technically feasible; unresolved critical SURVIVED mutations block successful seal.",
    "Multi-dimensional coverage-gap report contains zero high-risk unexplained BLOCKING_GAP entries.",
    "Medusa terminal evidence precedes native Foundry execution; both required engine families have deliberate refinement/rerun evidence.",
    "Source Intelligence is reused for structural facts; Phase 6A validates/repairs the accepted readiness inventory, commits a new accepted overlay/index revision, and Phase 6B/6C consume it without repeating Phase-1 discovery or Phase-6A admission.",
    "Security Traceability Graph, Domain Applicability Registry, obligation ledger and Evidence Invalidation Matrix are current; no due OPEN/IN_PROGRESS obligation remains.",
    "Final Phase-6 report is filed and P6_TO_P7 successor handoff/wake-up is sealed automatically; no human approval is required."
  ],
