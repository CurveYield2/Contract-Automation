{
  "schemaVersion": "audit-v7-phase-contract-v1",
  "phase": {
    "sequence": 6,
    "id": "phase-6",
    "title": "Three-Agent Comprehensive Dynamic Assurance",
    "reviewerLineage": "reviewer-3"
  },
  "authorization": {
    "automaticAdvance": true,
    "humanApprovalRequired": false,
    "subreviewerOrder": [
      "reviewer-3A",
      "reviewer-3B",
      "reviewer-3C"
    ],
    "freshSubreviewerRequiredAt": [
      "P6A_TO_P6B",
      "P6B_TO_P6C"
    ],
    "phase7FreshReviewerBoundary": "P6_TO_P7",
    "migrationProtocol": "resources/PHASE6_V29_COMPATIBILITY_AND_FALLBACK.md",
    "automaticAdvanceAfterSeal": true
  },
  "inputs": {
    "required": [
      "Exact controller-bound campaign generation",
      "Exact source identity/fence",
      "Current phase/revision and authorized reviewer lineage",
      "Sealed Phase 5 report and automatic successor-boundary authorization",
      "Accepted Phase-5 successor handoff receipt bound to reviewer-3",
      "Current SECURITY_TRACEABILITY_GRAPH checkpoint",
      "Current CARRIED_FORWARD_OBLIGATION_LEDGER checkpoint",
      "Current DOMAIN_APPLICABILITY_REGISTRY checkpoint",
      "Current EVIDENCE_INVALIDATION_MATRIX authority",
      "Latest controller-accepted Source Intelligence Bundle Index revision/commit/digest and component accepted identities bound to the exact current source/build identity"
    ],
    "conditional": [
      "Triggered domain ledgers/resources explicitly referenced by active steps",
      "Live deployment/release/fork/remediation artifacts only when the phase card trigger applies"
    ]
  },
  "steps": [
    {
      "step": 1,
      "action": "Resolve Phase-6 migration/current subreviewer",
      "instruction": "Load exact PHASE6_REVIEWER_STATE and P6.* durable evidence; apply no-repeat v28\u2192v29 migration when relevant.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "resources/PHASE6_V29_COMPATIBILITY_AND_FALLBACK.md",
        "resources/PHASE6_REVIEWER_STATE.json",
        "resources/PHASE6_SUBGATE_STATE.json"
      ]
    },
    {
      "step": 2,
      "action": "Execute Phase 6A with fresh reviewer-3A",
      "instruction": "Use the Phase-6A card/contract to design the complete assurance program, fill accounting/randomized/known-attack plans, execute P6.0 and seal execution readiness.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "subphases/phase-6A/START_HERE.md",
        "subphases/phase-6A/SUBPHASE_CONTRACT.json"
      ]
    },
    {
      "step": 3,
      "action": "Seal 6A and create P6A_TO_P6B automatically",
      "instruction": "After 6A hard seal, file subphase report, generate successor handoff/start/wake-up artifacts and enter WAITING_FOR_SUCCESSOR_AGENT.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "resources/PHASE6_SUBPHASE_REPORT.md",
        "resources/PHASE6_THREE_REVIEWER_PROTOCOL.md",
        "../../shared/handoff/SUCCESSOR_HANDOFF_PROTOCOL.md"
      ]
    },
    {
      "step": 4,
      "action": "Execute Phase 6B with fresh reviewer-3B",
      "instruction": "Accept P6A_TO_P6B and execute P6.1\u2013P6.6 / all Medusa-side Process 1\u201311 requirements plus v29 accounting-chaos and known-attack obligations.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "subphases/phase-6B/START_HERE.md",
        "subphases/phase-6B/SUBPHASE_CONTRACT.json"
      ]
    },
    {
      "step": 5,
      "action": "Seal 6B and create P6B_TO_P6C automatically",
      "instruction": "After terminal Medusa evidence and 6B hard seal, file subphase report, generate P6B_TO_P6C successor package/wake-up and stop reviewer-3B.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "resources/PHASE6_SUBPHASE_REPORT.md",
        "resources/PHASE6_THREE_REVIEWER_PROTOCOL.md",
        "../../shared/handoff/SUCCESSOR_HANDOFF_PROTOCOL.md"
      ]
    },
    {
      "step": 6,
      "action": "Execute Phase 6C with fresh reviewer-3C",
      "instruction": "Accept P6B_TO_P6C, execute P6.7 native Foundry independently, mutation sensitivity, multidimensional gap closure and P6.8 final reconciliation.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "subphases/phase-6C/START_HERE.md",
        "subphases/phase-6C/SUBPHASE_CONTRACT.json"
      ]
    },
    {
      "step": 7,
      "action": "Reconcile campaign-global security state and file final Phase-6 report",
      "instruction": "Update graph/domain/obligation/invalidation state, require zero unexplained blocking coverage gaps, complete campaign summary/ledger and file Phase Report. Enter AUTO_ADVANCE_READY; no human approval required.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "../../shared/controller/SECURITY_TRACEABILITY_GRAPH.json",
        "../../shared/controller/CARRIED_FORWARD_OBLIGATION_LEDGER.json",
        "../../shared/controller/EVIDENCE_INVALIDATION_MATRIX.json",
        "../../shared/reporting/PHASE_REPORT.md",
        "../../shared/controller/AUTOMATIC_PHASE_ADVANCEMENT_PROTOCOL.md"
      ]
    },
    {
      "step": 8,
      "action": "Create P6_TO_P7 successor package automatically",
      "instruction": "Immediately create/seal P6_TO_P7 successor handoff/start/wake-up artifacts for fresh reviewer-4.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "../../shared/handoff/SUCCESSOR_HANDOFF_PROTOCOL.md",
        "../../shared/handoff/SUCCESSOR_HANDOFF_BOUNDARY_PROFILES.json"
      ]
    },
    {
      "step": 9,
      "action": "Enter WAITING_FOR_SUCCESSOR_AGENT and stop",
      "instruction": "reviewer-3C must not execute Phase 7. Fresh reviewer-4 accepts the handoff.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "../../shared/controller/SOLO_WORKFLOW_STATE_MACHINE.json"
      ]
    }
  ],
