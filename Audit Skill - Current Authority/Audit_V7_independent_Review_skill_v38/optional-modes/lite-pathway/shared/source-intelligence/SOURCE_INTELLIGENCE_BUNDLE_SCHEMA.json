{
  "schemaVersion": "audit-v7-source-intelligence-bundle-schema-v1",
  "artifactSchemaVersion": "audit-v7-source-intelligence-bundle-index-v1",
  "template": "shared/source-intelligence/SOURCE_INTELLIGENCE_BUNDLE_TEMPLATE.json",
  "requiredTopLevelKeys": [
    "schemaVersion",
    "artifactType",
    "identity",
    "core",
    "overlays",
    "acceptanceRules",
    "completion"
  ],
  "requiredPointerKeys": [
    "logicalArtifactId",
    "canonicalMutablePath",
    "latestAcceptedRevision",
    "acceptedCommitSha",
    "acceptedSha256",
    "status",
    "lastVerifiedPhase",
    "invalidationStatus",
    "preservedSnapshotRef"
  ],
  "requiredOverlayKeys": [
    "runtimeDeployment",
    "assuranceReadiness"
  ],
  "allowedPointerStatus": [
    "ACCEPTED",
    "INVALIDATED_PENDING_REPLACEMENT",
    "NOT_APPLICABLE"
  ],
  "allowedInvalidationStatus": [
    "CURRENT",
    "REQUIRES_REBIND",
    "INVALIDATED",
    "NOT_APPLICABLE"
  ],
  "acceptedCommitShaPattern": "^[0-9a-f]{40}$",
  "acceptedSha256Pattern": "^[0-9a-f]{64}$",
  "forbiddenSentinel": "__FILL_REQUIRED__",
  "rules": [
    "The campaign bundle index is mutable controller state, but every accepted state must be committed and digest-referenced before use.",
    "A canonicalMutablePath is navigation only; acceptance is established by accepted revision, immutable commit SHA, SHA-256, status, and source/build binding.",
    "Prior accepted revisions remain immutable historical evidence.",
    "A sealed phase may use only the component revisions recorded in its immutable Phase Report and handoff evidence."
  ]
}
