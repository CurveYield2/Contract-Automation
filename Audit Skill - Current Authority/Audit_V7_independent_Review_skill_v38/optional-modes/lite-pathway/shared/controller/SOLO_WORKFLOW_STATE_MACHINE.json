{
  "schemaVersion": "audit-v7-lite-workflow-state-machine-v36",
  "processId": "audit-v7-independent-review-lite",
  "actorTopology": {
    "activeReviewerCount": 1,
    "sequentialReviewerLineages": 4,
    "reviewers": {
      "reviewer-1": {
        "phases": [
          1
        ],
        "model": "gpt-5.6-terra",
        "reasoning": "high"
      },
      "reviewer-2": {
        "phases": [
          2,
          3,
          4,
          5
        ],
        "model": "gpt-5.6-sol",
        "reasoning": "high"
      },
      "reviewer-3L": {
        "phases": [
          6,
          7
        ],
        "model": "gpt-5.6-sol",
        "reasoning": "high"
      },
      "reviewer-4": {
        "phases": [
          8,
          9,
          10
        ],
        "model": "gpt-5.6-sol",
        "reasoning": "high"
      }
    },
    "handoffBoundaries": [
      "P0_TO_P1",
      "P1_TO_P2",
      "P5_TO_P6",
      "P67_TO_P8"
    ],
    "orchestrator": {
      "optional": true,
      "model": "gpt-5.6-sol",
      "reasoning": "medium",
      "fallbackReasoning": "high",
      "milestoneReviews": 4,
      "conditionalFinalAdversarialReview": {
        "default": "NOT_TRIGGERED",
        "model": "gpt-5.6-sol",
        "reasoning": "max",
        "triggers": [
          "VALIDATED_HIGH_OR_CRITICAL_FINDING",
          "MATERIAL_UNRESOLVED_CONTRADICTION",
          "LOW_CONFIDENCE_HIGH_RISK_CLOSURE",
          "COMPLEX_MATERIAL_INTERACTION_REQUIRING_INDEPENDENT_CHALLENGE",
          "EXPLICIT_HUMAN_REQUEST"
        ]
      }
    },
    "bootstrapAgent": {
      "id": "web-bootstrap-agent",
      "phases": [
        0
      ],
      "executorClass": "CHATGPT_WEB_CHAT_GITHUB_CONNECTOR",
      "authority": "MECHANICAL_ONLY",
      "securityJudgmentAuthority": false,
      "retirementRequires": [
        "PHASE0_COMPLETION_VALIDATION_PASS",
        "P0_TO_P1_HANDOFF_VALIDATION_PASS"
      ]
    }
  },
  "globalInvariants": {
    "liteModeExplicitlySelected": true,
    "humanApprovalGateExists": false,
    "exactLocalSkillAndSourceZipPerOrchestratedDeployment": true,
    "campaignLinkAndWorkspacePathPerOrchestratedDeployment": true,
    "sourceIntelligenceCreatedInPhase1": false,
    "sourceIntelligenceVerifiedOnceAtCombinedPhase2Entry": true,
    "sourceIntelligenceReverifiedOnlyAfterMaterialIdentityChange": true,
    "domainApplicabilityClassifiedOnceInPhase3": true,
    "domainApplicabilityReevaluatedOnlyAfterTriggerFactChange": true,
    "phase2Through4SeparateReportsForbidden": true,
    "phase6And7Merged": true,
    "phase6FullCampaignsExcluded": true,
    "phase9ConditionalOnRemediation": true,
    "phase10ConciseLiteReportNotFullAssuranceCase": true,
    "sealedEvidenceMayNotBeRepeatedForConvenience": true,
    "sourceIntelligenceCreatedInPhase0WebBootstrap": true,
    "webBootstrapSecurityJudgmentAuthority": false,
    "webBootstrapMustSuperviseInitialAutomationToTerminalEvidence": true,
    "phaseRetirementRequiresControllerPass": true
  },
  "states": [
    "READY",
    "ACTIVE",
    "MILESTONE_EVIDENCE_SEALED",
    "MILESTONE_REPORT_SUBMITTED",
    "WAITING_FOR_SUCCESSOR_AGENT",
    "LITE_AUDIT_COMPLETE",
    "LITE_AUDIT_COMPLETE_WITH_LIMITATIONS",
    "BLOCKED",
    "LITE_TO_FULL_UPGRADE_REQUESTED"
  ],
  "milestones": [
    {
      "id": "P0_1",
      "segments": [
        0,
        1
      ],
      "reviewer": "reviewer-1",
      "reportAt": 1,
      "next": "P1_TO_P2",
      "segmentOwners": {
        "0": "web-bootstrap-agent",
        "1": "reviewer-1"
      },
      "bootstrapCompletionAt": 0,
      "bootstrapBoundary": "P0_TO_P1"
    },
    {
      "id": "P2_5",
      "segments": [
        2,
        3,
        4,
        5
      ],
      "reviewer": "reviewer-2",
      "reportAt": 5,
      "next": "P5_TO_P6"
    },
    {
      "id": "P6_7",
      "segments": [
        6,
        7
      ],
      "reviewer": "reviewer-3L",
      "reportAt": 7,
      "next": "P67_TO_P8",
      "retainedExecution": [
        "exactBuildAdmission",
        "completeDeployConfigSimulation",
        "candidateSpecificDeterministicSimulation",
        "basicTargetedFuzzing"
      ]
    },
    {
      "id": "P8_10",
      "segments": [
        8,
        9,
        10
      ],
      "reviewer": "reviewer-4",
      "reportAt": 10,
      "conditionalSegment": {
        "phase": 9,
        "condition": "REMEDIATION_ARTIFACTS_EXIST",
        "else": "SKIPPED_NO_REMEDIATION"
      },
      "next": "LITE_AUDIT_COMPLETE"
    }
  ],
  "upgrade": {
    "trigger": "EXPLICIT_HUMAN_FULL_UPGRADE",
    "route": "LITE_TO_FULL_UPGRADE.md",
    "resumeStandardAt": 6,
    "redoPhases0Through5": false,
    "alwaysReopenStandardPhase10": true
  }
}
