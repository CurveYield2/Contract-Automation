{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit-v7-lite-successor-handoff-v38",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "boundaryProfileId",
    "campaign",
    "authority",
    "assignment",
    "source",
    "reviewers",
    "milestone",
    "globalControls",
    "requiredEvidence",
    "dueObligations",
    "limitations",
    "integrity"
  ],
  "properties": {
    "schemaVersion": {
      "const": "audit-v7-lite-successor-handoff-v38"
    },
    "boundaryProfileId": {
      "enum": [
        "P0_TO_P1",
        "P1_TO_P2",
        "P5_TO_P6",
        "P67_TO_P8"
      ]
    },
    "campaign": {
      "type": "object",
      "required": [
        "campaignType",
        "campaignName",
        "campaignId",
        "campaignGenerationId",
        "workspacePath",
        "campaignFolderUrl",
        "campaignLink"
      ],
      "properties": {
        "campaignType": {
          "const": "LITE"
        },
        "campaignName": {
          "type": "string",
          "minLength": 1
        },
        "campaignId": {
          "type": "string",
          "minLength": 1
        },
        "campaignGenerationId": {
          "type": "string",
          "minLength": 1
        },
        "workspacePath": {
          "type": "string",
          "minLength": 1
        },
        "campaignFolderUrl": {
          "type": "string",
          "minLength": 1
        },
        "campaignLink": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "sourceIdentity",
        "buildIdentity",
        "skillZipIdentity",
        "sourceZipIdentity"
      ]
    },
    "reviewers": {
      "type": "object",
      "required": [
        "outgoing",
        "incoming"
      ]
    },
    "milestone": {
      "type": "object",
      "required": [
        "id",
        "status",
        "reportReference",
        "reportDigest"
      ]
    },
    "globalControls": {
      "type": "object",
      "required": [
        "securityTraceabilityGraph",
        "carriedForwardObligationLedger",
        "evidenceInvalidationMatrix",
        "sourceIntelligenceBundle"
      ]
    },
    "requiredEvidence": {
      "type": "array"
    },
    "dueObligations": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    },
    "integrity": {
      "type": "object",
      "required": [
        "sealedAt",
        "digest"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liteSkillRepositoryPath",
        "liteSkillUrl"
      ],
      "properties": {
        "liteSkillRepositoryPath": {
          "const": "CurveYield2/Contract-Automation/Audit Skill - Current Authority/Audit_V7_independent_Review_skill_v38/optional-modes/lite-pathway/SKILL.md"
        },
        "liteSkillUrl": {
          "const": "https://github.com/CurveYield2/Contract-Automation/blob/main/Audit%20Skill%20-%20Current%20Authority/Audit_V7_independent_Review_skill_v38/optional-modes/lite-pathway/SKILL.md"
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incomingReviewer",
        "assignedLitePhaseOrMilestone"
      ],
      "properties": {
        "incomingReviewer": {
          "type": "string",
          "minLength": 1
        },
        "assignedLitePhaseOrMilestone": {
          "enum": [
            "Phase 1",
            "Combined Lite Phases 2–5",
            "Merged Lite Phases 6–7",
            "Combined Lite Phases 8–10"
          ]
        }
      }
    }
  }
}
