{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit-v7-lite-successor-handoff-receipt-v38",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "boundaryProfileId",
    "campaignId",
    "campaignGenerationId",
    "incomingReviewer",
    "handoffReference",
    "handoffDigest",
    "checks",
    "status",
    "receivedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "audit-v7-lite-successor-handoff-receipt-v38"
    },
    "boundaryProfileId": {
      "enum": [
        "P0_TO_P1",
        "P1_TO_P2",
        "P5_TO_P6",
        "P67_TO_P8"
      ]
    },
    "campaignId": {
      "type": "string",
      "minLength": 1
    },
    "campaignGenerationId": {
      "type": "string",
      "minLength": 1
    },
    "incomingReviewer": {
      "enum": [
        "reviewer-1",
        "reviewer-2",
        "reviewer-3L",
        "reviewer-4"
      ]
    },
    "handoffReference": {
      "type": "string",
      "minLength": 1
    },
    "handoffDigest": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "REJECTED_REPAIR_REQUIRED",
        "BLOCKED"
      ]
    },
    "receivedAt": {
      "type": "string",
      "minLength": 1
    }
  }
}
