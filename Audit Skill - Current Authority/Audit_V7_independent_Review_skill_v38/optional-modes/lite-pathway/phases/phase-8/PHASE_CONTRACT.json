{
  "schemaVersion": "audit-v7-phase-contract-v1",
  "phase": {
    "sequence": 8,
    "id": "lite-candidate-validation-segment",
    "title": "Lite Combined Phases 8-10 - Candidate Validation",
    "reviewerLineage": "reviewer-4",
    "phaseCard": "phases/phase-8/START_HERE.md"
  },
  "authorization": {
    "controllerBoundCurrentPhaseRequired": true,
    "exactSourceFenceRequired": true,
    "incomingSuccessorReceipt": "P67_TO_P8",
    "combinedMilestone": "P8_TO_P10",
    "humanApprovalRequired": false
  },
  "inputs": {
    "required": [
      "Accepted P67_TO_P8 receipt",
      "Exact campaign/source/build identity",
      "Merged Lite Phase 6-7 evidence",
      "All candidate and validation obligations",
      "Current global control state"
    ],
    "conditional": [
      "Additional smallest decisive reproduction evidence",
      "Remediation artifacts supplied for a validated finding"
    ]
  },
  "steps": [
    {
      "step": 1,
      "action": "Accept handoff and bind candidate set",
      "instruction": "Verify exact identity and enumerate every candidate and carried validation obligation from the merged milestone.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "../../shared/handoff/SUCCESSOR_HANDOFF_RECEPTION_CHECKLIST.md",
        "resources/PHASE8_FINDING_VALIDATION_PACKET.md"
      ]
    },
    {
      "step": 2,
      "action": "Validate and calibrate every candidate",
      "instruction": "First group candidates that demonstrably share a root cause/source anchor/decisive evidence path and validate that shared premise once. Then independently establish each candidate's reachability, prerequisites, property violation, impact, outcome and severity; request additional evidence only where candidate-specific facts materially differ.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "resources/PHASE8_FINDING_VALIDATION_PACKET.md",
        "../../shared/policy/SEVERITY_CALIBRATION.md"
      ]
    },
    {
      "step": 3,
      "action": "Route remediation conditionally",
      "instruction": "Continue to Phase 9 only when remediation artifacts exist. Otherwise record SKIPPED_NO_REMEDIATION and continue directly to Phase 10 without a separate Phase-8 report or global seal.",
      "requirement": "MANDATORY",
      "condition": null,
      "resources": [
        "../phase-9/START_HERE.md",
        "../phase-10/START_HERE.md"
      ]
    }
  ],
  "requiredOutputs": [
    {
      "artifact": "phases/phase-8/resources/PHASE8_FINDING_VALIDATION_PACKET.md",
      "role": "VALIDATED_FINDING_RECORDS",
      "required": true
    },
    {
      "artifact": "shared/controller/SECURITY_TRACEABILITY_GRAPH.json",
      "role": "LIVE_GLOBAL_STATE",
      "required": true
    },
    {
      "artifact": "shared/controller/CARRIED_FORWARD_OBLIGATION_LEDGER.json",
      "role": "LIVE_GLOBAL_STATE",
      "required": true
    }
  ],
  "globalControlCheckpoints": {
    "securityTraceabilityGraph": "UPDATE_LIVE_NO_SEGMENT_SEAL",
    "carriedForwardObligationLedger": "UPDATE_LIVE_NO_SEGMENT_SEAL",
    "evidenceInvalidationMatrix": "CLASSIFY_ONLY_IF_CHANGE_OBSERVED",
    "sealAtPhase10": true
  },
  "sealingCriteria": [
    "Every material candidate has an evidence-backed validation outcome",
    "Every validated finding has severity and remediation guidance",
    "Phase-9 branch condition is explicitly recorded",
    "Shared-premise/root-cause validation may be reused across related candidates, but every candidate retains an individual evidence-backed final disposition."
  ],
  "recoveryRoutes": [
    {
      "condition": "Evidence inconclusive",
      "route": "Obtain only the smallest decisive retained-method evidence or record INCONCLUSIVE"
    },
    {
      "condition": "Material identity change",
      "route": "Invalidate affected evidence and reopen only impacted validation"
    },
    {
      "condition": "No remediation artifacts",
      "route": "Skip Phase 9 and continue to Phase 10"
    }
  ],
  "allowedNextStates": [
    "LITE_PHASE9_ACTIVE_IF_REMEDIATION",
    "LITE_PHASE10_ACTIVE"
  ],
  "domainApplicability": {
    "classificationRequiredHere": false,
    "recheckPolicy": "ONLY_ON_NEW_TRIGGER_FACT"
  },
  "universalRuleIds": [
    "U-EXEC-001",
    "U-GITHUB-001",
    "U-STATE-001",
    "U-EVIDENCE-001",
    "U-REPAIR-001",
    "U-HUMAN-001",
    "U-DISCLOSURE-001",
    "U-SOURCEINTEL-001",
    "U-UPDATES-001",
    "U-HUMANCOMMS-001"
  ]
}
