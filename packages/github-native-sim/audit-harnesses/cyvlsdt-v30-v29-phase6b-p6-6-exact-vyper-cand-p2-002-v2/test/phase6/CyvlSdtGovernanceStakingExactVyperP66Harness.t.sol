}

contract P66ExactSourceToken is ERC20 {
    constructor(string memory name_, string memory symbol_) ERC20(name_, symbol_) {}
    function mint(address to, uint256 amount) external { _mint(to, amount); }
}

contract P66ExactVyperActor {
    IERC20 public immutable lp;
    IExactCurveYieldGovernanceStaking public immutable gauge;
    address public immutable controller;

    constructor(address lp_, address gauge_, address controller_) {
        lp = IERC20(lp_);
        gauge = IExactCurveYieldGovernanceStaking(gauge_);
        controller = controller_;
        lp.approve(gauge_, type(uint256).max);
    }

    function stake(uint256 amount) external {
        require(msg.sender == controller, "controller only");
        gauge.deposit(amount);
    }

    function claim() external {
        require(msg.sender == controller, "controller only");
        gauge.claim_rewards();
    }
}

