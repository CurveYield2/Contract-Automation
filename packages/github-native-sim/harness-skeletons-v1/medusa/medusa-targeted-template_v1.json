{
  "fuzzing": {
    "workers": 10,
    "testLimit": 250000,
    "shrinkLimit": 15000,
    "callSequenceLength": 200,
    "coverageEnabled": true,
    "corpusDirectory": "phase6-corpus/targeted",
    "coverageFormats": ["lcov", "html"],
    "revertReporterEnabled": true,
    "targetContracts": ["PHASE6_TARGETED_HARNESS"],
    "senderAddresses": ["0x10000", "0x20000", "0x30000", "0x40000"],
    "blockNumberDelayMax": 128,
    "blockTimestampDelayMax": 604800,
    "testing": {
      "stopOnFailedTest": false,
      "stopOnNoTests": true,
      "testAllContracts": false,
      "testViewMethods": true,
      "assertionTesting": { "enabled": true },
      "propertyTesting": {
        "enabled": true,
        "testPrefixes": ["property_", "invariant_", "echidna_"]
      },
      "optimizationTesting": { "enabled": false, "testPrefixes": ["optimize_"] },
      "targetFunctionSignatures": [
        "PHASE6_TARGETED_HARNESS.PHASE6_ACTION_A(uint256)",
        "PHASE6_TARGETED_HARNESS.PHASE6_ACTION_B(uint256)",
        "PHASE6_TARGETED_HARNESS.PHASE6_ACTION_C(address,uint256)"
      ],
      "excludeFunctionSignatures": []
    }
  },
  "compilation": {
    "platform": "crytic-compile",
    "platformConfig": {
      "target": ".",
      "args": ["--foundry-compile-all"]
    }
  },
  "slither": {
    "useSlither": true
  }
}
