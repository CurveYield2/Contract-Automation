pragma solidity >=0.8.13 <0.9.0;

// Runtime: adapt/import the instantiated v1 targeting + handler files.
import {Phase6InvariantTargetingV1} from "./Phase6InvariantTargeting_v1.sol";
import {Phase6StatefulHandlerV1} from "./Phase6StatefulHandler_v1.sol";

/// @notice Audit-only invariant suite skeleton. Apply curveyield-contract-intro before instantiation.
/// A target-specific concrete test MUST implement the hooks below from sealed Phase 2-5 evidence.
abstract contract Phase6InvariantSuiteV1 is Phase6InvariantTargetingV1 {
    address internal phase6Target;
    Phase6StatefulHandlerV1 internal phase6Handler;
    address[] internal phase6Actors;

    // --- Target-specific setup / property hooks ---
    function _phase6DeployOrBindFrozenSystem() internal virtual returns (address target);
    function _phase6BuildActors() internal virtual returns (address[] memory actors);
    function _phase6SecurityProperty001() internal view virtual returns (bool);
    function _phase6SecurityProperty002() internal view virtual returns (bool);
    function _phase6ReferenceModelConsistent() internal view virtual returns (bool);

    function setUp() public virtual {
        phase6Target = _phase6DeployOrBindFrozenSystem();
        require(phase6Target != address(0), "PHASE6_TARGET_ZERO");

        phase6Actors = _phase6BuildActors();
        require(phase6Actors.length >= 2, "PHASE6_ACTOR_MODEL_TOO_SMALL");

        phase6Handler = new Phase6StatefulHandlerV1(phase6Target, phase6Actors);

        // Target the handler so Forge generates stateful sequences from the modeled flows.
        _phase6TargetContract(address(phase6Handler));

        // Prefer explicit selectors for Campaign B/C so setup/view/quality helpers are not fuzz actions.
        bytes4[] memory selectors = new bytes4[](4);
        selectors[0] = Phase6StatefulHandlerV1.actionA.selector;
        selectors[1] = Phase6StatefulHandlerV1.actionB.selector;
        selectors[2] = Phase6StatefulHandlerV1.actionC.selector;
        selectors[3] = Phase6StatefulHandlerV1.advanceTime.selector;
        _phase6TargetSelector(address(phase6Handler), selectors);

        // Preserve actor semantics. A target-specific suite may omit targetSender when handler actorSeed
        // performs actor switching internally; if used, document why both dimensions add assurance.
        for (uint256 i = 0; i < phase6Actors.length; i++) {
            _phase6TargetSender(phase6Actors[i]);
        }
    }

    function invariant_security_property_001() public view {
        require(_phase6SecurityProperty001(), "PHASE6_PROPERTY_001_FALSIFIED");
    }

    function invariant_security_property_002() public view {
        require(_phase6SecurityProperty002(), "PHASE6_PROPERTY_002_FALSIFIED");
    }

    /// @dev Keep only when Process 9 is triggered and the model is materially independent.
    function invariant_reference_model_consistency() public view {
        require(_phase6ReferenceModelConsistent(), "PHASE6_REFERENCE_MODEL_DIVERGENCE");
    }

    /// @notice Foundry invokes this after each invariant run when present.
    /// Use it to reject a nominally passing campaign whose handler never exercised meaningful state.
    function afterInvariant() public view {
        (uint256 successes, uint256 reverts, uint256 totalCalls) = phase6Handler.handlerQuality();
        require(totalCalls > 0, "PHASE6_DEAD_HANDLER");
        require(successes > 0, "PHASE6_NO_SUCCESSFUL_STATE_TRANSITIONS");

        // Do not hard-code a universal acceptable revert ratio. Gate B must interpret this against
        // the intended bounded/hostile campaign mode and preserve the metrics as evidence.
        successes;
        reverts;
    }
}
