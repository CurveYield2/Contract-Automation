        uint256 delta = _bounded(rawSeconds, 1, PHASE6_MAX_TIME_DELTA);
        vm.warp(block.timestamp + delta);
        vm.roll(block.number + 1);
        timeTransitions++;
    }

    function handlerQuality() external view returns (
