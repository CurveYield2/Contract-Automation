{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curveyield.dev/schemas/adversarial-kb/executable-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","executableId","incidentRefs","patternRefs","recipeRefs","backend","toolVersion","language","sourceFiles","expectedSetup","requiredRpcForkState","requiredBlockIdentity","requiredImpersonation","requiredTokenBalances","expectedResult","proofStatusRef","lastQualification"],
  "properties": {
    "schemaVersion": {"const": "adversarial-kb-executable-v1"},
    "executableId": {"type": "string", "pattern": "^EXEC-[0-9]{4}$"},
    "incidentRefs": {"type": "array", "items": {"type": "string", "pattern": "^EXP-[0-9]{4}-[0-9]{4}$"}},
    "patternRefs": {"type": "array", "items": {"type": "string", "pattern": "^PATTERN-[0-9]{4}$"}},
    "recipeRefs": {"type": "array", "items": {"type": "string", "pattern": "^RECIPE-[0-9]{4}$"}},
    "backend": {"type": "string", "enum": ["medusa","foundry","anvil"]},
    "toolVersion": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "sourceFiles": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["path","digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
    },
    "expectedSetup": {"type": "array", "items": {}},
    "requiredRpcForkState": {"type": "object"},
    "requiredBlockIdentity": {"anyOf": [{"type": "null"},{"type": "object"}]},
    "requiredImpersonation": {"type": "array", "items": {}},
    "requiredTokenBalances": {"type": "array", "items": {}},
    "expectedResult": {},
    "proofStatusRef": {"type": "string", "pattern": "^PROOF-[0-9]{4}$"},
    "lastQualification": {"type": "object", "additionalProperties": false, "required": ["commit","runId"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "runId": {"type": "string", "minLength": 1}}}
  }
}
