{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curveyield.dev/schemas/adversarial-kb/executable-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","executableId","revision","incidentRefs","patternRefs","recipeRefs","knowledgeBindings","backend","toolVersion","language","sourceFiles","executionMode","expectedSetup","requiredRpcForkState","requiredBlockIdentity","requiredImpersonation","requiredTokenBalances","expectedResult","expectedEvidence","proofStatusRef","lastQualification"],
  "properties": {
    "schemaVersion": {"const": "adversarial-kb-executable-v1"},
    "executableId": {"type": "string", "pattern": "^EXEC-[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "incidentRefs": {"type": "array", "items": {"type": "string", "pattern": "^EXP-[0-9]{4}-[0-9]{4}$"}},
    "patternRefs": {"type": "array", "items": {"type": "string", "pattern": "^PATTERN-[0-9]{4}$"}},
    "recipeRefs": {"type": "array", "items": {"type": "string", "pattern": "^RECIPE-[0-9]{4}$"}},
    "knowledgeBindings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind","id","revision","digest"],
        "properties": {
          "kind": {"type": "string", "enum": ["incident","pattern","recipe"]},
          "id": {"type": "string", "minLength": 1},
          "revision": {"type": "integer", "minimum": 1},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "backend": {"type": "string", "enum": ["medusa","foundry","anvil"]},
    "toolVersion": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "sourceFiles": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["path","digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
    },
    "executionMode": {"type": "string", "enum": ["CONTROLLED","HISTORICAL"]},
    "expectedSetup": {"type": "array", "items": {}},
    "requiredRpcForkState": {
      "type": "object", "additionalProperties": false,
      "required": ["required","chain","archiveRequired","rpcEnvVar"],
      "properties": {
        "required": {"type": "boolean"},
        "chain": {"anyOf": [{"type": "null"},{"type": "string", "minLength": 1}]},
        "archiveRequired": {"type": "boolean"},
        "rpcEnvVar": {"anyOf": [{"type": "null"},{"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}]}
      }
    },
    "requiredBlockIdentity": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["blockNumber","blockHash"], "properties": {"blockNumber": {"type": "integer", "minimum": 0}, "blockHash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"}}}
      ]
    },
    "requiredImpersonation": {"type": "array", "items": {}},
    "requiredTokenBalances": {"type": "array", "items": {}},
    "expectedResult": {"type": "object"},
    "expectedEvidence": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["kind","required"], "properties": {"kind": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}}}
    },
    "proofStatusRef": {"type": "string", "pattern": "^PROOF-[0-9]{4}$"},
    "lastQualification": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["commit","runId"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "runId": {"type": "string", "minLength": 1}}}
      ]
    }
  }
}
