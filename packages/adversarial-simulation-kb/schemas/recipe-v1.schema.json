{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curveyield.dev/schemas/adversarial-kb/recipe-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","recipeId","patternRefs","targetTopologies","requiredTargetBindings","setupSteps","attackSteps","observations","assertions","adaptationInputs","backendSupport","executableRefs","proofStatusRef"],
  "properties": {
    "schemaVersion": {"const": "adversarial-kb-recipe-v1"},
    "recipeId": {"type": "string", "pattern": "^RECIPE-[0-9]{4}$"},
    "patternRefs": {"type": "array", "items": {"type": "string", "pattern": "^PATTERN-[0-9]{4}$"}, "minItems": 1},
    "targetTopologies": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "requiredTargetBindings": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "setupSteps": {"type": "array", "items": {}},
    "attackSteps": {"type": "array", "items": {}},
    "observations": {"type": "array", "items": {}},
    "assertions": {"type": "array", "items": {}},
    "adaptationInputs": {"type": "array", "items": {}},
    "backendSupport": {
      "type": "object", "additionalProperties": false, "required": ["medusa","foundry","anvil"],
      "properties": {
        "medusa": {"type": "string", "enum": ["SUPPORTED","ADAPTATION_REQUIRED","UNSUPPORTED"]},
        "foundry": {"type": "string", "enum": ["SUPPORTED","ADAPTATION_REQUIRED","UNSUPPORTED"]},
        "anvil": {"type": "string", "enum": ["SUPPORTED","ADAPTATION_REQUIRED","UNSUPPORTED"]}
      }
    },
    "executableRefs": {"type": "array", "items": {"type": "string", "pattern": "^EXEC-[0-9]{4}$"}},
    "proofStatusRef": {"type": "string", "pattern": "^PROOF-[0-9]{4}$"}
  }
}
