{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curveyield.dev/schemas/adversarial-kb/attack-pattern-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","patternId","revision","name","description","rootCauseClass","structuralPreconditions","runtimePreconditions","attackerCapabilities","attackSequenceAbstract","expectedSecurityPropertyViolation","sourceIntelligenceSignals","runtimeOverlaySignals","nonApplicabilitySignals","falsePositiveGuards","adaptationRules","recommendedBackends","historicalIncidentRefs","recipeRefs","limitations"],
  "properties": {
    "schemaVersion": {"const": "adversarial-kb-pattern-v1"},
    "patternId": {"type": "string", "pattern": "^PATTERN-[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "rootCauseClass": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "structuralPreconditions": {"type": "array", "items": {}},
    "runtimePreconditions": {"type": "array", "items": {}},
    "attackerCapabilities": {"type": "array", "items": {}},
    "attackSequenceAbstract": {"type": "array", "items": {}},
    "expectedSecurityPropertyViolation": {"type": "array", "items": {}},
    "sourceIntelligenceSignals": {"type": "array", "items": {}},
    "runtimeOverlaySignals": {"type": "array", "items": {}},
    "nonApplicabilitySignals": {"type": "array", "items": {}},
    "falsePositiveGuards": {"type": "array", "items": {}, "minItems": 1},
    "adaptationRules": {"type": "array", "items": {}},
    "recommendedBackends": {"type": "array", "items": {"type": "string", "enum": ["medusa","foundry","anvil"]}, "minItems": 1},
    "historicalIncidentRefs": {"type": "array", "items": {"type": "string", "pattern": "^EXP-[0-9]{4}-[0-9]{4}$"}},
    "recipeRefs": {"type": "array", "items": {"type": "string", "pattern": "^RECIPE-[0-9]{4}$"}},
    "limitations": {"type": "array", "items": {}}
  }
}
