{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curveyield.dev/schemas/adversarial-kb/incident-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "incidentId",
    "revision",
    "title",
    "incidentDate",
    "affectedProtocol",
    "affectedChain",
    "affectedContracts",
    "lossEstimate",
    "sourceType",
    "incidentStatus",
    "rootCauseSummary",
    "attackSummary",
    "preconditions",
    "attackSteps",
    "violatedProperties",
    "affectedPatterns",
    "attackPrimitives",
    "applicabilitySignals",
    "nonApplicabilitySignals",
    "falsePositiveGuards",
    "requiredCapabilities",
    "runtimeRequirements",
    "references",
    "reproductionRefs",
    "generalizedPatternRefs",
    "proofStatusRef",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {"const": "adversarial-kb-incident-v1"},
    "incidentId": {"type": "string", "pattern": "^EXP-[0-9]{4}-[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "incidentDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "affectedProtocol": {"type": "string", "minLength": 1},
    "affectedChain": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "affectedContracts": {"type": "array", "items": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"}},
    "lossEstimate": {"type": "object"},
    "sourceType": {"const": "HISTORICAL_EXPLOIT"},
    "incidentStatus": {"type": "string", "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "DISPUTED", "REFERENCE_ONLY"]},
    "rootCauseSummary": {"type": "string", "minLength": 1},
    "attackSummary": {"type": "string", "minLength": 1},
    "preconditions": {"type": "array", "items": {}},
    "attackSteps": {"type": "array", "items": {}},
    "violatedProperties": {"type": "array", "items": {}},
    "affectedPatterns": {"type": "array", "items": {"type": "string", "pattern": "^PATTERN-[0-9]{4}$"}},
    "attackPrimitives": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "applicabilitySignals": {"type": "array", "items": {}},
    "nonApplicabilitySignals": {"type": "array", "items": {}},
    "falsePositiveGuards": {"type": "array", "items": {}},
    "requiredCapabilities": {"type": "array", "items": {}},
    "runtimeRequirements": {"type": "array", "items": {}},
    "references": {"type": "array", "items": {"type": "string", "pattern": "^SOURCE-[0-9]{4}$"}},
    "reproductionRefs": {"type": "array", "items": {"type": "string", "pattern": "^EXEC-[0-9]{4}$"}},
    "generalizedPatternRefs": {"type": "array", "items": {"type": "string", "pattern": "^PATTERN-[0-9]{4}$"}},
    "proofStatusRef": {"type": "string", "pattern": "^PROOF-[0-9]{4}$"},
    "limitations": {"type": "array", "items": {}}
  }
}
